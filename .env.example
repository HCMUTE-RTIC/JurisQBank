# Django
SECRET_KEY=django-insecure-change-me-in-production-!@#$1234
DEBUG=True
ALLOWED_HOSTS=*

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jurisqbank
# Optional: DATABASE_URL=postgres://postgres:postgres@localhost:5432/jurisqbank

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_STORAGE_BUCKET_NAME=learning-materials
MINIO_S3_ENDPOINT_URL=http://localhost:9000
MINIO_S3_REGION_NAME=us-east-1

# Google Auth
GOOGLE_CLIENT_ID=your-google-client-id-here
# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=JurisQBank <no-reply@jurisqbank.com>
